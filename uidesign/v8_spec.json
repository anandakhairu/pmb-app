    "absolute_rules": [
      "Design exclusively for one user role: prospective student.",
      "There must be exactly one admission process.",
      "Registration waves are time periods, not separate admission pathways.",
      "Each application has exactly one primary study program.",
      "All applicants follow one institutional selection process.",
      "Do not create mobile or tablet frames.",
      "Do not create any administrative interface.",
      "Do not create unnecessary features outside applicant needs."
    ]
  },
  "admission_business_model": {
    "admission_type": "Single Admission Process",
    "registration_model": "Multiple Registration Waves",
    "program_preference_count": 1,
    "selection_process": "One Unified Institutional Selection Process",
    "registration_wave_examples": [
      "Gelombang 1",
      "Gelombang 2",
      "Gelombang 3"
    ],
    "registration_wave_properties": [
      "Wave name",
      "Opening date",
      "Closing date",
      "Registration status",
      "Registration fee when applicable",
      "Payment deadline when applicable",
      "Registration availability",
      "Official announcement"
    ],
    "wave_statuses": [
      "Upcoming",
      "Open",
      "Closing Soon",
      "Closed",
      "Full"
    ],
    "wave_rules": [
      "All waves belong to the same admission process.",
      "Only one registration wave can be selected per application.",
      "Only open registration waves are selectable.",
      "Closing-soon waves remain selectable until the official deadline.",
      "Upcoming and closed waves cannot be selected for new applications.",
      "The selected wave must be recorded in the applicant application.",
      "Different waves may have different official fees or promotional information.",
      "Never invent registration dates or fees."
    ],
    "program_selection_rules": [
      "The applicant chooses one primary study program.",
      "Do not implement ranked preferences.",
      "Do not implement multiple program choices.",
      "Program changes are only represented through an authorized correction process when permitted."
    ],
    "selection_stages": [
      "Document Review",
      "Academic Assessment",
      "Written Examination",
      "Interview",
      "Final Evaluation"
    ],
    "selection_stage_rules": [
      "These are stages within one admission process.",
      "Not all stages are mandatory.",
      "Only institutionally supported stages should appear.",
      "Do not create independent admission pathways."
    ]
  },

  "anti_ai_slop": {
    "strictly_forbidden": [
      "Generic AI-generated SaaS landing page",
      "Repetitive three-column feature card sections",
      "Tiny blue eyebrow labels above every heading",
      "Oversized headings repeated in every section",
      "Excessive gradients",
      "Excessive glassmorphism",
      "Random floating decorative circles",
      "Random decorative blobs",
      "Excessive rounded cards",
      "Excessive pill-shaped elements",
      "Fake testimonials",
      "Fabricated university statistics",
      "Random stock photographs",
      "Unnecessary icon decorations",
      "Excessive shadows",
      "Repeated identical section compositions",
      "Inconsistent spacing",
      "Inconsistent typography",
      "Artificially crowded layouts",
      "Unnecessary section dividers",
      "Decorative elements without a usability purpose"
    ],
    "mandatory_quality_rules": [
      "Each section must have a layout justified by its content.",
      "Do not repeat the same composition across consecutive sections.",
      "Use photography as meaningful content, not decoration.",
      "Use appropriate image aspect ratios.",
      "Prioritize strong typography and visual hierarchy.",
      "Preserve natural whitespace.",
      "Use cards only when grouping information is meaningful.",
      "Use clear visual differences between primary and secondary actions.",
      "Maintain a recognizable university brand identity.",
      "Design must look art-directed by an experienced human product design team."
    ],
    "visual_review_questions": [
      "Does the interface look like a real university product rather than a generic template?",
      "Does every section have a clear purpose?",
      "Are the headings visually balanced?",
      "Are cards being overused?",
      "Is photography relevant to the content?",
      "Is the page visually distinctive without unnecessary decoration?",
      "Can applicants understand the next action immediately?"
    ]
  },

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id_admin             String                 @id @default(uuid()) @db.Uuid
  nama                 String
  email                String                 @unique
  password             String
  role_spesifik        String?
  formulir_pendaftaran FormulirPendaftaran[]
}

model CalonMahasiswa {
  id_mahasiswa         String                 @id @default(uuid()) @db.Uuid
  nama_lengkap         String
  email                String                 @unique
  password             String
  no_hp                String
  created_at           DateTime               @default(now())
  
  data_asal_sekolah    DataAsalSekolah?
  formulir_pendaftaran FormulirPendaftaran[]
  perangkat_notifikasi PerangkatNotifikasi[]
}

model DataAsalSekolah {
  id_sekolah   String         @id @default(uuid()) @db.Uuid
  id_mahasiswa String         @unique @db.Uuid
  nisn         String         @unique
  npsn         String
  nama_sekolah String
  jurusan      String?
  
  mahasiswa    CalonMahasiswa @relation(fields: [id_mahasiswa], references: [id_mahasiswa], onDelete: Cascade)
}

model JalurPendaftaran {
  id_jalur             String                 @id @default(uuid()) @db.Uuid
  nama_jalur           String                 @unique
  butuh_ujian_cbt      Boolean                @default(false)
  
  formulir_pendaftaran FormulirPendaftaran[]
}

model ProgramStudi {
  id_prodi             String                 @id @default(uuid()) @db.Uuid
  nama_prodi           String
  fakultas             String
  
  formulir_pendaftaran FormulirPendaftaran[]
}

model FormulirPendaftaran {
  id_formulir       String              @id @default(uuid()) @db.Uuid
  id_mahasiswa      String              @db.Uuid
  id_prodi          String              @db.Uuid
  id_jalur          String              @db.Uuid
  id_admin_pic      String?             @db.Uuid
  nomor_pendaftaran String?             @unique
  status_berkas     String              @default("MENUNGGU")
  status_kelulusan  String              @default("BELUM_DIPROSES")

  mahasiswa         CalonMahasiswa      @relation(fields: [id_mahasiswa], references: [id_mahasiswa], onDelete: Cascade)
  program_studi     ProgramStudi        @relation(fields: [id_prodi], references: [id_prodi])
  jalur_pendaftaran JalurPendaftaran    @relation(fields: [id_jalur], references: [id_jalur])
  admin_pic         Admin?              @relation(fields: [id_admin_pic], references: [id_admin])
  
  berkas_dokumen    BerkasDokumen[]
  tagihan_pembayaran TagihanPembayaran[]
  jadwal_ujian_cbt  JadwalUjianCbt?
}

model BerkasDokumen {
  id_berkas       String              @id @default(uuid()) @db.Uuid
  id_formulir     String              @db.Uuid
  nama_berkas     String
  file_url        String
  status_validasi String              @default("MENUNGGU")
  
  formulir        FormulirPendaftaran @relation(fields: [id_formulir], references: [id_formulir], onDelete: Cascade)
}

model TagihanPembayaran {
  id_tagihan    String              @id @default(uuid()) @db.Uuid
  id_formulir   String              @db.Uuid
  jenis_tagihan String
  nominal       Int
  status_bayar  String              @default("BELUM_BAYAR")
  bukti_bayar   String?
  
  formulir      FormulirPendaftaran @relation(fields: [id_formulir], references: [id_formulir], onDelete: Cascade)
}

model JadwalUjianCbt {
  id_ujian      String              @id @default(uuid()) @db.Uuid
  id_formulir   String              @unique @db.Uuid
  tanggal_ujian DateTime
  lokasi_gedung String
  nomor_kursi   String
  
  formulir      FormulirPendaftaran @relation(fields: [id_formulir], references: [id_formulir], onDelete: Cascade)
}

model PerangkatNotifikasi {
  id_notifikasi  String         @id @default(uuid()) @db.Uuid
  id_mahasiswa   String         @db.Uuid
  kode_browser   String
  kunci_keamanan String
  
  mahasiswa      CalonMahasiswa @relation(fields: [id_mahasiswa], references: [id_mahasiswa], onDelete: Cascade)
}
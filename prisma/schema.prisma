// =============================================================================
// SISTEM PMB - schema.prisma (v2: 11 tabel)
// Stack: Prisma + Supabase (PostgreSQL)
// Catatan: autentikasi dikelola Supabase Auth (schema "auth"). Tabel
// calon_mahasiswa & admin menyimpan profil dan terhubung lewat auth_user_id.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) untuk runtime
  directUrl = env("DIRECT_URL")   // koneksi langsung untuk migrasi
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN

  @@map("jenis_kelamin")
}

enum JenjangProdi {
  D3
  D4
  S1

  @@map("jenjang_prodi")
}

/// Status siklus berkas pada formulir pendaftaran
enum StatusBerkas {
  DRAFT          // masih diisi/diedit maba
  DIKIRIM        // sudah difinalisasi, antre review
  DALAM_REVIEW   // sedang diperiksa admin
  REVISI         // admin meminta perbaikan (ada catatan)
  TERVERIFIKASI  // berkas dinyatakan valid

  @@map("status_berkas")
}

enum StatusKelulusan {
  BELUM_DITETAPKAN
  LULUS
  CADANGAN
  TIDAK_LULUS

  @@map("status_kelulusan")
}

enum JenisDokumen {
  PAS_FOTO
  KTP_KK
  IJAZAH_SKL
  RAPOR
  SURAT_KETERANGAN_PENGHASILAN
  DOKUMEN_PENDUKUNG

  @@map("jenis_dokumen")
}

enum StatusVerifikasiBerkas {
  MENUNGGU
  VALID
  REVISI

  @@map("status_verifikasi_berkas")
}

enum StatusTagihan {
  BELUM_BAYAR
  MENUNGGU_KONFIRMASI
  LUNAS
  KEDALUWARSA
  DIBATALKAN

  @@map("status_tagihan")
}

enum RoleAdmin {
  SUPER_ADMIN
  VERIFIKATOR
  PANITIA

  @@map("role_admin")
}

// -----------------------------------------------------------------------------
// 1. CALON MAHASISWA (pendaftar)
// -----------------------------------------------------------------------------

model CalonMahasiswa {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId    String       @unique @map("auth_user_id") @db.Uuid // -> auth.users.id (Supabase)
  email         String       @unique @db.VarChar(255)
  namaLengkap   String       @map("nama_lengkap") @db.VarChar(150)
  nik           String?      @unique @db.Char(16)
  tempatLahir   String?      @map("tempat_lahir") @db.VarChar(100)
  tanggalLahir  DateTime?    @map("tanggal_lahir") @db.Date
  jenisKelamin  JenisKelamin? @map("jenis_kelamin")
  noHp          String?      @map("no_hp") @db.VarChar(20)
  alamat        String?      @db.Text
  kotaKabupaten String?      @map("kota_kabupaten") @db.VarChar(100)
  provinsi      String?      @db.VarChar(100)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  asalSekolah        DataAsalSekolah?
  formulir           FormulirPendaftaran[]
  perangkatNotifikasi PerangkatNotifikasi[]

  @@map("calon_mahasiswa")
}

// -----------------------------------------------------------------------------
// 2. DATA ASAL SEKOLAH (1-1 dengan calon_mahasiswa)
// -----------------------------------------------------------------------------

model DataAsalSekolah {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mahasiswaId    String   @unique @map("mahasiswa_id") @db.Uuid
  namaSekolah    String   @map("nama_sekolah") @db.VarChar(200)
  npsn           String?  @db.VarChar(8)
  jenisSekolah   String?  @map("jenis_sekolah") @db.VarChar(50) // SMA/SMK/MA/Paket C
  jurusan        String?  @db.VarChar(100)
  tahunLulus     Int      @map("tahun_lulus") @db.SmallInt
  nilaiRataRata  Decimal  @map("nilai_rata_rata") @db.Decimal(5, 2)
  alamatSekolah  String?  @map("alamat_sekolah") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mahasiswa CalonMahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)

  @@map("data_asal_sekolah")
}

// -----------------------------------------------------------------------------
// 3. PROGRAM STUDI (master)
// -----------------------------------------------------------------------------

model ProgramStudi {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode       String       @unique @db.VarChar(10)
  nama       String       @db.VarChar(150)
  fakultas   String       @db.VarChar(150)
  jenjang    JenjangProdi
  akreditasi String?      @db.VarChar(20)
  kuota      Int          @default(0)
  deskripsi  String?      @db.Text
  /// Tarif UKT per golongan, dipakai Kalkulator Simulasi UKT.
  /// Format: [{ "golongan": 1, "minPenghasilan": 0, "maxPenghasilan": 2500000, "biaya": 500000 }, ...]
  /// (maxPenghasilan = null berarti tanpa batas atas)
  tarifUkt   Json         @default("[]") @map("tarif_ukt")
  aktif      Boolean      @default(true)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  formulir FormulirPendaftaran[]

  @@index([fakultas])
  @@map("program_studi")
}

// -----------------------------------------------------------------------------
// 4. JALUR PENDAFTARAN (master)
// -----------------------------------------------------------------------------

model JalurPendaftaran {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode              String   @unique @db.VarChar(20)
  nama              String   @db.VarChar(100)
  deskripsi         String?  @db.Text
  /// Daftar persyaratan jalur, satu item per baris (ditampilkan di halaman publik)
  persyaratan       String[] @default([])
  butuhUjianCbt     Boolean  @default(false) @map("butuh_ujian_cbt")
  biayaPendaftaran  Decimal  @default(0) @map("biaya_pendaftaran") @db.Decimal(12, 2)
  tanggalBuka       DateTime @map("tanggal_buka") @db.Timestamptz(6)
  tanggalTutup      DateTime @map("tanggal_tutup") @db.Timestamptz(6)
  tanggalPengumumanHasil DateTime? @map("tanggal_pengumuman_hasil") @db.Timestamptz(6)
  aktif             Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  formulir FormulirPendaftaran[]
  jadwalUjian JadwalUjianCbt[]

  @@map("jalur_pendaftaran")
}

// -----------------------------------------------------------------------------
// 5. FORMULIR PENDAFTARAN (core transaksi)
// -----------------------------------------------------------------------------

model FormulirPendaftaran {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Diterbitkan saat finalisasi. Contoh: PMB-2026-000123
  nomorPendaftaran  String?         @unique @map("nomor_pendaftaran") @db.VarChar(30)
  tahunAkademik     String          @map("tahun_akademik") @db.VarChar(9) // "2026/2027"

  mahasiswaId       String          @map("mahasiswa_id") @db.Uuid
  prodiId           String          @map("prodi_id") @db.Uuid
  jalurId           String          @map("jalur_id") @db.Uuid
  jadwalUjianId     String?         @map("jadwal_ujian_id") @db.Uuid

  /// Admin yang memverifikasi berkas / menetapkan hasil
  verifikatorId     String?         @map("verifikator_id") @db.Uuid
  penetapId         String?         @map("penetap_id") @db.Uuid

  /// Progres multi-step: 1 Biodata, 2 Asal Sekolah, 3 Pilih Prodi, 4 Unggah Berkas
  langkahTerakhir   Int             @default(1) @map("langkah_terakhir") @db.SmallInt
  statusBerkas      StatusBerkas    @default(DRAFT) @map("status_berkas")
  statusKelulusan   StatusKelulusan @default(BELUM_DITETAPKAN) @map("status_kelulusan")
  catatanRevisi     String?         @map("catatan_revisi") @db.Text
  catatanKelulusan  String?         @map("catatan_kelulusan") @db.Text

  finalisasiAt      DateTime?       @map("finalisasi_at") @db.Timestamptz(6)
  diverifikasiAt    DateTime?       @map("diverifikasi_at") @db.Timestamptz(6)
  ditetapkanAt      DateTime?       @map("ditetapkan_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  mahasiswa   CalonMahasiswa   @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  prodi       ProgramStudi     @relation(fields: [prodiId], references: [id], onDelete: Restrict)
  jalur       JalurPendaftaran @relation(fields: [jalurId], references: [id], onDelete: Restrict)
  jadwalUjian JadwalUjianCbt?  @relation(fields: [jadwalUjianId], references: [id], onDelete: SetNull)
  verifikator Admin?           @relation("FormulirVerifikator", fields: [verifikatorId], references: [id], onDelete: SetNull)
  penetap     Admin?           @relation("FormulirPenetap", fields: [penetapId], references: [id], onDelete: SetNull)

  berkas   BerkasDokumen[]
  tagihan  TagihanPembayaran[]

  // Satu pendaftar hanya boleh punya 1 formulir per tahun akademik
  @@unique([mahasiswaId, tahunAkademik])
  @@index([statusBerkas, finalisasiAt]) // antrean admin
  @@index([prodiId, statusKelulusan])
  @@index([jalurId])
  @@map("formulir_pendaftaran")
}

// -----------------------------------------------------------------------------
// 6. BERKAS DOKUMEN (file di Supabase Storage / R2)
// -----------------------------------------------------------------------------

model BerkasDokumen {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formulirId        String                 @map("formulir_id") @db.Uuid
  jenis             JenisDokumen
  namaFile          String                 @map("nama_file") @db.VarChar(255)
  /// Path di bucket (mis. "berkas/{formulirId}/ijazah.pdf"); URL signed dibuat saat diakses
  storagePath       String                 @map("storage_path") @db.VarChar(500)
  mimeType          String                 @map("mime_type") @db.VarChar(100)
  ukuranByte        Int                    @map("ukuran_byte")
  statusVerifikasi  StatusVerifikasiBerkas @default(MENUNGGU) @map("status_verifikasi")
  catatan           String?                @db.Text
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  formulir FormulirPendaftaran @relation(fields: [formulirId], references: [id], onDelete: Cascade)

  // Satu dokumen per jenis per formulir (unggah ulang = replace)
  @@unique([formulirId, jenis])
  @@map("berkas_dokumen")
}

// -----------------------------------------------------------------------------
// 7. JADWAL UJIAN CBT
// -----------------------------------------------------------------------------

model JadwalUjianCbt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jalurId       String   @map("jalur_id") @db.Uuid
  nama          String   @db.VarChar(150) // "Gelombang 1 - Sesi Pagi"
  tanggal       DateTime @db.Date
  jamMulai      DateTime @map("jam_mulai") @db.Time(0)
  jamSelesai    DateTime @map("jam_selesai") @db.Time(0)
  lokasi        String   @db.VarChar(200)
  kapasitas     Int
  tautanUjian   String?  @map("tautan_ujian") @db.Text
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  jalur    JalurPendaftaran      @relation(fields: [jalurId], references: [id], onDelete: Cascade)
  formulir FormulirPendaftaran[]

  @@index([jalurId, tanggal])
  @@map("jadwal_ujian_cbt")
}

// -----------------------------------------------------------------------------
// 8. TAGIHAN PEMBAYARAN
// -----------------------------------------------------------------------------

model TagihanPembayaran {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formulirId     String        @map("formulir_id") @db.Uuid
  nomorTagihan   String        @unique @map("nomor_tagihan") @db.VarChar(30)
  deskripsi      String        @db.VarChar(200) // "Biaya Pendaftaran Jalur Mandiri"
  nominal        Decimal       @db.Decimal(12, 2)
  status         StatusTagihan @default(BELUM_BAYAR)
  metode         String?       @db.VarChar(50)
  buktiBayarUrl  String?       @map("bukti_bayar_url") @db.Text
  jatuhTempo     DateTime      @map("jatuh_tempo") @db.Timestamptz(6)
  dibayarAt      DateTime?     @map("dibayar_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  formulir FormulirPendaftaran @relation(fields: [formulirId], references: [id], onDelete: Cascade)

  @@index([formulirId])
  @@index([status, jatuhTempo])
  @@map("tagihan_pembayaran")
}

// -----------------------------------------------------------------------------
// 9. ADMIN (panitia)
// -----------------------------------------------------------------------------

model Admin {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId String    @unique @map("auth_user_id") @db.Uuid // -> auth.users.id (Supabase)
  email      String    @unique @db.VarChar(255)
  nama       String    @db.VarChar(150)
  role       RoleAdmin @default(PANITIA)
  aktif      Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  formulirDiverifikasi FormulirPendaftaran[] @relation("FormulirVerifikator")
  formulirDitetapkan   FormulirPendaftaran[] @relation("FormulirPenetap")
  perangkatNotifikasi  PerangkatNotifikasi[]
  pengumuman           Pengumuman[]

  @@map("admin")
}

// -----------------------------------------------------------------------------
// 10. PERANGKAT NOTIFIKASI (Web Push subscription)
// Catatan: VAPID *private/public key server* disimpan di env, BUKAN di tabel.
// Tabel ini menyimpan subscription (endpoint + p256dh + auth) tiap perangkat.
// -----------------------------------------------------------------------------

model PerangkatNotifikasi {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mahasiswaId String?   @map("mahasiswa_id") @db.Uuid
  adminId     String?   @map("admin_id") @db.Uuid
  endpoint    String    @unique @db.Text
  p256dh      String    @db.Text
  authKey     String    @map("auth_key") @db.Text
  userAgent   String?   @map("user_agent") @db.Text
  aktif       Boolean   @default(true)
  terakhirDipakai DateTime? @map("terakhir_dipakai") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  mahasiswa CalonMahasiswa? @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  admin     Admin?          @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([mahasiswaId])
  @@index([adminId])
  @@map("perangkat_notifikasi")
}

// -----------------------------------------------------------------------------
// 11. PENGUMUMAN (dikelola admin, tampil di halaman publik)
// -----------------------------------------------------------------------------

model Pengumuman {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId        String?   @map("admin_id") @db.Uuid
  judul          String    @db.VarChar(200)
  slug           String    @unique @db.VarChar(220)
  ringkasan      String?   @db.VarChar(300)
  isi            String    @db.Text
  dipublikasikan Boolean   @default(false)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([dipublikasikan, publishedAt])
  @@map("pengumuman")
}
